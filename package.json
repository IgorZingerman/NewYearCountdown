{
  "name": "new-year-countdown",
  "version": "1.3.3",
  "description": "Happy Holidays!",
  "main": "src/cli/index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp .htaccess out/.htaccess 2>/dev/null || true",
    "export": "next build && cp .htaccess out/.htaccess 2>/dev/null || true",
    "build:static": "next build && cp .htaccess out/.htaccess 2>/dev/null || true",
    "deploy": "./scripts/deploy.sh",
    "start": "next start",
    "lint": "next lint",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "build:cli": "babel --config-file .babel/babel.config.cjs --out-dir=dist src/cli",
    "start:cli": "node dist/cli/index.js",
    "dev:cli": "babel --config-file .babel/babel.config.cjs --out-dir=dist --watch src/cli",
    "transpile": "mkdir -p dist && babel --config-file .babel/babel.config.cjs src/cli/index.js > dist/cli/index.js",
    "prepublish": "npm run transpile",
    "preview-fonts": "babel --config-file .babel/babel.config.cjs src/cli/preview-fonts.js --out-file dist/cli/preview-fonts.js && node dist/cli/preview-fonts.js"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "gsap": "^3.14.1",
    "ink": "^4.4.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-progress-bar": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-animation": "^0.1.0",
    "next": "^16.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.4",
    "@babel/plugin-transform-react-jsx": "^7.23.4",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}

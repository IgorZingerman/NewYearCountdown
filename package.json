{
  "name": "new-year-countdown",
  "version": "1.3.3",
  "description": "Happy Holidays!",
  "main": "src/index.js",
  "scripts": {
    "build": "babel --out-dir=dist src",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "start": "node dist/index.js",
    "dev": "babel --out-dir=dist --watch src",
    "transpile": "mkdir -p dist && babel src/index.js > dist/index.js",
    "prepublish": "npm run transpile",
    "preview-fonts": "babel src/preview-fonts.js --out-file dist/preview-fonts.js && node dist/preview-fonts.js"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "ink": "^4.4.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-progress-bar": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-animation": "^0.1.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.4",
    "@babel/plugin-transform-react-jsx": "^7.23.4",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
